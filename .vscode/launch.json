{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug fichier courant",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${file}",
    },
    {
      "name": "Debug rex-admin",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/backend/admin/cmd/main.go",
      "args": ["${workspaceFolder}/backend/admin/cmd/config.yaml"],
      "cwd": "${workspaceFolder}/backend/admin",
      "envFile": "${workspaceFolder}/.vscode/secrets-dev.env"
    },
        {
      "name": "Debug rex-student",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/backend/student/cmd/main.go",
      "args": ["${workspaceFolder}/backend/student/cmd/config.yaml"],
      "cwd": "${workspaceFolder}/backend/student",
      "envFile": "${workspaceFolder}/.vscode/secrets-dev.env"
    },

  ]
}

