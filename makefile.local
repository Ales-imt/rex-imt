.PHONY: local deploy-local infra-local stop-infra migration-local cyber_note start-local stop-local build-local build-admin-local start-admin stop-admin build-eleve-local start-eleve stop-eleve db-to-code-local build-sync-local build-export-local start-sync stop-sync start-export stop-export

# Cherche dans la topologie PUIS dans les secrets. `-f2-` et non `-f2` : une
# valeur contenant un « = » (padding base64) serait sinon tronquée en silence.
_get_local=$(shell grep -h '^$(1)=' $(CONFIG_FILE_LOCAL) $(SECRETS_FILE_LOCAL) 2>/dev/null | head -1 | cut -d= -f2-)

local:  infra-local migration-local cyber_note build-local  start-local


#
# ── Infra ─────────────────────────────────────────────────────────────────────

infra-local:
	@echo "--- 🐳 Démarrage des conteneurs Docker ---"
	cd $(DOCKER_DIR) && docker compose -f compose.yaml --env-file ../../$(CONFIG_FILE_LOCAL) --env-file ../../$(SECRETS_FILE_LOCAL) up -d

	@echo "--- 🗑️ suppression de la bd db_rex ---"
	docker exec -i postgres-16.10-alpine-rex psql -U postgres -c "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = 'db_rex';"
	docker exec -i postgres-16.10-alpine-rex psql -U postgres -c "DROP DATABASE IF EXISTS db_rex;"
	@echo "--- 🆕 création de la bd db_rex ---"
	docker exec -i postgres-16.10-alpine-rex psql -U postgres -c "CREATE DATABASE db_rex;"

	@echo "--- 🗑️ suppression de la bd MariaDB ---"
	docker exec -i mariadb-rex mariadb -u root -p$(call _get_local,MARIADB_PASSWORD) \
		-e "DROP DATABASE IF EXISTS $(call _get_local,MARIADB_DB);"
	@echo "--- 🆕 création de la bd MariaDB ---"
	docker exec -i mariadb-rex mariadb -u root -p$(call _get_local,MARIADB_PASSWORD) \
		-e "CREATE DATABASE $(call _get_local,MARIADB_DB);"

stop-infra:
	@echo "--- 🛑 Arrêt des conteneurs Docker ---"
	cd $(DOCKER_DIR) && docker compose -f compose.yaml --env-file ../../$(CONFIG_FILE_LOCAL) --env-file ../../$(SECRETS_FILE_LOCAL) down

# ── Migration ──────────────────────────────────────────────────────────────────────

migration-local:
	$(INFRA_DIR)/migrate-v0-to-v1.sh $(SECRETS_FILE_LOCAL)

# ── Import des notes ──────────────────────────────────────────────────────────────────────

cyber_note:
	@echo "--- 🐬 Import des notes CyberNotes dans MariaDB ---"
	docker exec -i mariadb-rex mariadb \
		-u $(call _get_local,MARIADB_USER) \
		-p$(call _get_local,MARIADB_PASSWORD) \
		--skip-ssl  \
		$(call _get_local,MARIADB_DB) < $(INFRA_DIR)/bd_data/dump_cyber_notes.sql


# ── Conteneurs locaux ─────────────────────────────────────────────────────────

start-local: start-admin start-eleve start-sync start-export

start-admin: fetch-freetsa-cert-if-missing build-admin-local
	$(RUN_DIR)/start-admin-local.sh

start-eleve: build-eleve-local
	$(RUN_DIR)/start-eleve-local.sh

stop-local: stop-admin stop-eleve stop-sync stop-export stop-infra

build-local : build-admin-local build-eleve-local build-sync-local build-export-local

build-admin-local: db-to-code-local
	$(RUN_DIR)/build-admin.sh local $(IMAGE_TAG)

build-eleve-local: db-to-code-local
	$(RUN_DIR)/build-eleve.sh local $(IMAGE_TAG)

build-sync-local: db-to-code-local
	$(RUN_DIR)/build-sync.sh local $(IMAGE_TAG)

# L'image embarque wine et le préfixe WinDev : premier build long (~590 Mo de
# couche), les suivants réutilisent le cache tant que la version de wine ne
# bouge pas. UID 1000 en local, celui du développeur.
build-export-local:
	$(RUN_DIR)/build-export-webdfd.sh local $(IMAGE_TAG) 1000

db-to-code-local:
	@echo "--- 🆕 gen code sqlc ---"
	$(INFRA_DIR)/db-to-code.sh $(SECRETS_FILE_LOCAL)

stop-admin:
	@echo "--- 🛑 Arrêt du container admin ---"
	docker rm -f $(ADMIN_CONTAINER) 2>/dev/null || true

stop-eleve:
	@echo "--- 🛑 Arrêt du container élève ---"
	docker rm -f $(ELEVE_CONTAINER) 2>/dev/null || true

start-sync: build-sync-local
	$(RUN_DIR)/start-sync-local.sh

stop-sync:
	@echo "--- 🛑 Arrêt du container sync ---"
	docker rm -f $(SYNC_CONTAINER) 2>/dev/null || true

# Démarré par `make local` bien que la source configurée soit peut-être webdfd :
# le service tourne alors à vide, en attente d'un dépôt. C'est voulu — on veut
# pouvoir éprouver la chaîne hfsql sans rien reconfigurer.
#
# Il coûte ~2 Go d'image et quelques minutes au PREMIER build (wine 32 bits et
# wineboot) ; ensuite la couche est réutilisée, y compris à UID différent.
start-export: build-export-local
	$(RUN_DIR)/start-export-local.sh

stop-export:
	@echo "--- 🛑 Arrêt du container export-webdfd ---"
	docker rm -f $(EXPORT_CONTAINER) 2>/dev/null || true
