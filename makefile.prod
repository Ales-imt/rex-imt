.PHONY: first-deploy-prod release-prod release-prod-admin release-prod-eleve migration-prod db-to-code-prod build-container-admin-prod build-container-eleve-prod push deploy-vm-prod deploy-vm-admin-prod deploy-vm-eleve-prod

first-deploy-prod: migration-prod release-prod

release-prod: release-prod-admin release-prod-eleve

release-prod-admin: db-to-code-prod build-container-admin-prod push deploy-vm-admin-prod

release-prod-eleve: db-to-code-prod build-container-eleve-prod push deploy-vm-eleve-prod

# ── MIGRATION ──────────────────────────────────────────────────────────────────────

# ne se fait qu'un fois, A SUPPRIMER PAR LA SUITE DANGER DANGER !!!!

migration-prod:
	echo "A FAIRE UNE FOIS LORS DE LA MISE EN PLACE !!!", PUIS SUPPRIMER LA REGLE !!!!!!
	sleep 3
	$(INFRA_DIR)/migrate-v0-to-v1.sh $(SECRETS_FILE_PROD)

# ── Code ──────────────────────────────────────────────────────────────────────

db-to-code-prod:
	$(INFRA_DIR)/db-to-code.sh $(SECRETS_FILE_PROD)

# ── Build ──────────────────────────────────────────────────────────────────────

build-container-admin-prod:
	$(RUN_DIR)/build-admin.sh prod

build-container-eleve-prod:
	$(RUN_DIR)/build-eleve.sh prod


# ── Push ──────────────────────────────────────────────────────────────────────

push:
	$(RUN_DIR)/push-container.sh

# ── Configure VM et deploy ──────────────────────────────────────────────────────────────────────

deploy-vm-prod: deploy-vm-admin-prod deploy-vm-eleve-prod

deploy-vm-admin-prod:
	@echo "--- 🚀 Creation du vault pour ansible ---"
	cd $(ANSIBLE_DIR) && ./generate-vault-vars.sh
	@echo "--- 🚀 Déploiement Admin ---"
	cd $(ANSIBLE_DIR) && ansible-playbook -i inventory/prod playbook-admin.yml --extra-vars "@vault-vars.yml" --ask-become-pass

deploy-vm-eleve-prod:
	@echo "--- 🚀 Creation du vault pour ansible ---"
	cd $(ANSIBLE_DIR) && ./generate-vault-vars.sh
	@echo "--- 🚀 Déploiement Eleve ---"
	cd $(ANSIBLE_DIR) && ansible-playbook -i inventory/prod playbook-eleve.yml --extra-vars "@vault-vars.yml" --ask-become-pass
