# Topologie — aucun secret ici.
#
# Adresses, ports, noms de bases, identifiants et clés publiques. Séparé des
# secrets pour que ces derniers restent peu nombreux et lisibles, et pour
# pouvoir donner à chaque service uniquement ce dont il a besoin.
#
# La variante `local` est VERSIONNÉE : elle décrit le réseau docker de
# développement (voir infras/container/compose.yaml) et permet de démarrer sans
# rien deviner. Seuls les secrets restent à renseigner.


# ── PostgreSQL ──────────────────────────────────────────────────────────────────
POSTGRES_HOST=sql2.mines-ales.fr
POSTGRES_PORT=5433
POSTGRES_DB=dfxevaluation2
POSTGRES_USER=dfximtrexuser

# ── MariaDB (cybernotes) ────────────────────────────────────────────────────────
MARIADB_HOST=sql2.mines-ales.fr
MARIADB_PORT=3306
MARIADB_DB=cybernotes
MARIADB_USER=cybernotes_lire

# ── Annuaire ────────────────────────────────────────────────────────────────────
LDAP_HOST=ldap.mines-ales.fr

# ── IA locale ───────────────────────────────────────────────────────────────────
# À RENSEIGNER — voir l'analyse du découpage.
OLLAMA_HOST=

# ── Programme (source aurega) ───────────────────────────────────────────────────
# À RENSEIGNER — voir l'analyse du découpage.
AUREGA_BASE_URL=

# ── Chiffrement des feedbacks — clé PUBLIQUE age, publiable par construction ────
AGE_PUBLIC_KEY=age1vnxd5q5w4z23hlg7ge0jss29r835qg49d926rq4yefkvkr8d4yyql8tmzx

# ── Relais SMTP du témoin externe ─────────────────────────────────────
SMTP_HOST=mail.mines-ales.fr
SMTP_PORT=25
# Vide : le relais interne n'authentifie pas, aucune auth n'est alors tentée.
SMTP_USERNAME=

# ── Génération des bulletins ────────────────────────────────────────────────────
GOTENBERG_URL=http://localhost:3000

# ── Sauvegardes HFSQL (source `hfsql` de rex-sync) ──────────────────────────────
# Dépôt alimenté par Samba, et exports produits par rex-export-webdfd.
# Ansible les reprend via generate-vault-vars.sh (hfsql_depot / hfsql_data) pour
# les montages Quadlet et les gabarits de configuration.
#
# HFSQL_DEPOT est le chemin du partage Samba tel qu'il est déclaré sur la VM
# (section [hfsql] de smb.conf) : c'est lui qui fixe la valeur, pas l'inverse.
#
# Les deux répertoires sont disjoints et frères, jamais imbriqués. Ils le
# doivent : export-webdfd dézippe dans HFSQL_DATA et purge la racine de
# l'archive avant de l'extraire, ce qui viserait le dépôt s'il était en dessous.
#
# Aucun des deux ne vit dans /home/userdfx : les app_dir y sont créés en 0750,
# et rex-sync tourne sous un compte non privilégié (USER rex du Dockerfile) que
# podman rootless remappe dans la plage subuid, pas vers userdfx. Il ne pourrait
# pas traverser un parent en 0750 pour lire les exports.
HFSQL_DEPOT=/srv/hfsql
HFSQL_DATA=/srv/hfsql-exports
