# Topologie — aucun secret ici.
#
# Adresses, ports, noms de bases, identifiants et clés publiques. Séparé des
# secrets pour que ces derniers restent peu nombreux et lisibles, et pour
# pouvoir donner à chaque service uniquement ce dont il a besoin.
#
# La variante `local` est VERSIONNÉE : elle décrit le réseau docker de
# développement (voir infras/container/compose.yaml) et permet de démarrer sans
# rien deviner. Seuls les secrets restent à renseigner.


# ── PostgreSQL ──────────────────────────────────────────────────────────────────
POSTGRES_HOST=10.20.1.4
POSTGRES_PORT=5432
POSTGRES_DB=db_rex
POSTGRES_USER=postgres

# ── MariaDB (cybernotes) ────────────────────────────────────────────────────────
MARIADB_HOST=10.20.1.6
MARIADB_PORT=3306
MARIADB_DB=cyber_notes
MARIADB_USER=root

# ── Annuaire ────────────────────────────────────────────────────────────────────
LDAP_HOST=10.20.1.5

# ── IA locale ───────────────────────────────────────────────────────────────────
OLLAMA_HOST=10.20.1.2

# ── Programme (source aurega) ───────────────────────────────────────────────────
# À RENSEIGNER — voir l'analyse du découpage.
AUREGA_BASE_URL=

# ── Chiffrement des feedbacks — clé PUBLIQUE age, publiable par construction ────
AGE_PUBLIC_KEY=age1ajn5xm3qfe6ppvwqyvdlzprw9rr6wcj8tvmfv6csyr2fgc8ukdzs5dvw9y

# ── Relais SMTP du témoin externe ─────────────────────────────────────
SMTP_HOST=10.20.1.1
SMTP_PORT=2525
# Vide : le relais interne n'authentifie pas, aucune auth n'est alors tentée.
SMTP_USERNAME=

# ── Génération des bulletins ────────────────────────────────────────────────────
GOTENBERG_URL=http://10.20.1.7:3000

# ── Sauvegardes HFSQL (source `hfsql` de rex-sync) ──────────────────────────────
# Dépôt alimenté par Samba, et exports produits par rex-export-webdfd. Lus par
# les scripts de lancement uniquement : ils s'en servent pour monter les
# répertoires et adapter les config.yaml copiées.
#
# SEULES valeurs de ce fichier propres à la machine — à ajuster après clonage.
# Surchargeables ponctuellement : HFSQL_DATA=/ailleurs make start-sync
#
# En prod, ces chemins ne sont PAS ici : ils vivent dans infras/ansible/vars/,
# d'où ansible les propage aux montages ET aux gabarits de configuration. Les
# déclarer en double créerait deux sources de vérité qui divergeraient.
HFSQL_DEPOT=/home/vjo/tmp/hfsql/depot
HFSQL_DATA=/home/vjo/tmp/hfsql/data

# ── Accès réseau sortant ────────────────────────────────────────────────────────
HTTP_PROXY=socks5h://127.0.0.1:1080
NO_PROXY=localhost,127.0.0.1
