# Gabarit des secrets — VERSIONNÉ, valeurs vides.
#
# Copier en secrets-local.env (et secrets-prod.env pour la production), puis
# renseigner. Ces deux fichiers ne sont jamais versionnés ; celui-ci existe pour
# que la LISTE des secrets attendus, elle, le soit.
#
# Pourquoi cette liste importe : os.ExpandEnv remplace une variable absente par
# une chaîne VIDE, sans message. Un secret oublié ne se voit pas au démarrage.
#
# La topologie — adresses, ports, comptes, clés publiques — n'est pas ici : voir
# config-local.env, versionné, et README.md.

# ── Authentification applicative ────────────────────────────────────────────────
JWT_SECRET_ADMIN=
JWT_SECRET_ELEVE=
PRESENCE_TOKEN_SECRET=

# ── Bases de données ────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=
MARIADB_PASSWORD=

# ── Services tiers ──────────────────────────────────────────────────────────────
# Seule la clé du fournisseur retenu (ia.provider) est requise.
RACK_API_KEY=
RAGARENN_API_KEY=
MISTRAL_API_KEY=
# À RENSEIGNER — voir l'analyse du découpage.
AUREGA_API_KEY=

# ── Registre d'images ───────────────────────────────────────────────────────────
GITHUB_DOCKER_TOKEN=

# ── Témoin externe des ancrages de présence ─────────────────────────────────────
# Le relais interne (port 25) n'authentifie pas : sans SMTP_USERNAME côté
# topologie, aucune authentification n'est tentée et ce mot de passe reste vide.
# Ne le renseigner que si le relais l'exige (cf. pkg/mailer/mailer.go).
SMTP_PASSWORD=
# Destinataire du témoin. Ce n'est pas un secret, mais une donnée à caractère
# personnel : il vit ici pour rester hors du dépôt, le reste de la topologie
# étant versionné. Cf. docs/rgpd-dpo.md et docs/temoin-externe.md — la boîte
# doit être tenue par un rôle DISTINCT de l'administrateur d'infrastructure.
WITNESS_RECIPIENT=
