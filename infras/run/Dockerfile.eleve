# ── Stage 1 : build Go backend élève ────────────────────────────────────────
FROM golang:1.25-alpine AS backend-builder

RUN apk add --no-cache git

WORKDIR /app

COPY backend/common ./common
COPY backend/student ./student

# Copie de l'historique git pour git describe
COPY .git ./.git

WORKDIR /app/student

ARG VERSION
ARG BUILD_TIME
RUN VERSION="${VERSION:-$(git describe --tags --always --dirty 2>/dev/null || echo "dev")}" && \
    BUILD_TIME="${BUILD_TIME:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}" && \
    go build -ldflags="-s -w -X main.version=${VERSION} -X main.buildTime=${BUILD_TIME}" -o /rex-eleve-server ./cmd

# ── Stage 2 : build Expo web ─────────────────────────────────────────────────
FROM node:22-alpine AS frontend-builder

WORKDIR /app

COPY apps/mobile/package*.json ./
RUN npm ci

COPY apps/mobile/ ./

# Relie l'API vers nginx (proxy /api → backend Go sur port 3300)
ENV EXPO_PUBLIC_API_BASE=/api/v2

RUN npx expo export --platform web --no-minify

# ── Stage 3 : image finale ───────────────────────────────────────────────────
FROM alpine:3.21

RUN apk add --no-cache nginx

# Utilisateur non-root
RUN addgroup -S rex && adduser -S rex -G rex

COPY --from=backend-builder /rex-eleve-server /usr/local/bin/rex-eleve-server
COPY --from=frontend-builder /app/dist /usr/share/nginx/html
COPY infras/run/nginx-eleve.conf /etc/nginx/nginx.conf

RUN mkdir -p /opt/rex-eleve/conf

COPY infras/run/start-eleve.sh /start.sh
RUN chmod +x /start.sh

# Permissions pour l'utilisateur rex
RUN chown -R rex:rex /usr/share/nginx/html /var/log/nginx /var/lib/nginx /opt/rex-eleve && \
    mkdir -p /tmp/client_body /tmp/proxy /tmp/fastcgi /tmp/uwsgi /tmp/scgi && \
    chown -R rex:rex /tmp/client_body /tmp/proxy /tmp/fastcgi /tmp/uwsgi /tmp/scgi

USER rex

EXPOSE 8080

CMD ["/start.sh"]
